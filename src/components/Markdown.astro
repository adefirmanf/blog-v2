---
// Markdown related imports
import rehypeStringify from "rehype-stringify";
import remarkParse from "remark-parse";
import remarkRehype from "remark-rehype";
import remarkToc from "remark-toc";
import remarkHeaderId from "remark-heading-id";
import remarkGfm from "remark-gfm";
import rehypeExpressiveCode from "rehype-expressive-code";
import { unified } from "unified";
import { pluginCodeOutput } from "@fujocoded/expressive-code-output";

export interface Props {
  markdownContent: string;
  codeTheme?: ["github-light", "github-dark"];
}
const { markdownContent, codeTheme } = Astro.props;
const rehype = unified()
  .use(remarkParse)
  .use(remarkHeaderId, { defaults: true, uniqueDefaults: true })
  .use(remarkToc, {
    heading: "Table of Contents",
    tight: true,
  })
  .use(remarkGfm)
  .use(remarkRehype)
  .use(rehypeExpressiveCode, {
    themes: codeTheme,
    frames: { showCopyToClipboardButton: true },
    plugins: [pluginCodeOutput],
  })
  .use(rehypeStringify);

const content = await rehype.process(markdownContent);
---

<div set:html={content} />
